# use vim as the visual editor
export VISUAL=vim
export EDITOR=$VISUAL

# ensure dotfiles bin directory is loaded first
export PATH="$HOME/.bin:/usr/local/sbin:$PATH"

# load rbenv if available
if which rbenv &>/dev/null ; then
  eval "$(rbenv init - --no-rehash)"
fi

# mkdir .git/safe in the root of repositories you trust
export PATH=".git/safe/../../bin:$PATH"

# Silence zoxide doctor in non-interactive shells — Claude Code's shell
# snapshot replays cd/__zoxide_hook but not chpwd_functions membership,
# causing a spurious warning. Interactive shells keep the check.
[[ ! -o interactive ]] && export _ZO_DOCTOR=0

# Local config
[[ -f ~/.zshenv.local ]] && source ~/.zshenv.local
