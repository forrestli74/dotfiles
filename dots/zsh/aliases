# Unix
alias ls='ls --color=auto'
alias ll="ls -al"
alias mkdir="mkdir -p"
alias tmux0="tmux attach || tmux"

# Pretty print the path
alias path='echo $PATH | tr -s ":" "\n"'

if command -v claude &>/dev/null; then
    alias cc="claude --dangerously-skip-permissions"
fi

if command -v nvim &>/dev/null; then
    alias vim='nvim'
fi

# Include custom aliases
[[ -f ~/.aliases.local ]] && source ~/.aliases.local

if command -v pnpm >/dev/null 2>&1; then
    alias npm='pnpm'
    # pnpm dlx doesn't support -y/--yes (it auto-confirms by default),
    # but many tools call npx with -y, so strip it for compatibility
    npx() {
        local args=()
        for arg in "$@"; do
            [[ "$arg" == "-y" || "$arg" == "--yes" ]] && continue
            args+=("$arg")
        done
        pnpm dlx --silent "${args[@]}"
    }
fi
