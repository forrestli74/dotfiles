# ============================================================
# Shell bootstrap
# ============================================================
try_source() {
  [[ -r $1 ]] && source $1
}

# ============================================================
# Platform bootstrap — package managers and system PATH
# ============================================================

# linuxbrew (Linux)
if [[ -d $HOME/.linuxbrew ]]; then
  export PATH="$HOME/.linuxbrew/bin:$PATH"
  export MANPATH="$HOME/.linuxbrew/share/man:$MANPATH"
  export INFOPATH="$HOME/.linuxbrew/share/info:$INFOPATH"
fi

# Homebrew on Apple Silicon — hardcoded instead of `eval "$(brew shellenv)"`
# to avoid the ~20-30ms brew subprocess on every shell start.
if [[ -d /opt/homebrew ]]; then
  export HOMEBREW_PREFIX="/opt/homebrew"
  export HOMEBREW_CELLAR="/opt/homebrew/Cellar"
  export HOMEBREW_REPOSITORY="/opt/homebrew"
  export PATH="/opt/homebrew/bin:/opt/homebrew/sbin${PATH+:$PATH}"
  export MANPATH="/opt/homebrew/share/man${MANPATH+:$MANPATH}:"
  export INFOPATH="/opt/homebrew/share/info:${INFOPATH:-}"
  fpath=(/opt/homebrew/share/zsh/site-functions $fpath)
fi

# ============================================================
# Shell behavior — completion, history, aliases
# ============================================================

# completion
autoload -U compinit
compinit

# Tab twice to enter interactive menu (arrow keys to select, Enter to accept)
zstyle ':completion:*' menu select

# history
setopt hist_ignore_all_dups inc_append_history
HISTFILE=~/.zhistory
HISTSIZE=1048576
SAVEHIST=1048576

# aliases
try_source ~/.aliases

# clipboard (Wayland)
if command -v wl-copy &> /dev/null; then
  alias pbcopy='wl-copy'
  alias pbpaste='wl-paste'
fi

# ============================================================
# Tools — PATH entries and shell integrations
# ============================================================

# Rust
if [[ -d $HOME/.cargo/bin ]]; then
  export PATH="$HOME/.cargo/bin:$PATH"
fi

# CUDA (Linux with NVIDIA)
if [[ -d /usr/local/cuda/lib64 ]]; then
  export PATH="/usr/local/cuda/bin:$PATH"
  export LD_LIBRARY_PATH="$LD_LIBRARY_PATH:/usr/local/cuda/lib64"
  export CUDA_HOME=/usr/local/cuda
fi

# pnpm (macOS — $HOME/Library only exists on mac)
if [[ -d "$HOME/Library/pnpm" ]]; then
  export PNPM_HOME="$HOME/Library/pnpm"
  case ":$PATH:" in
    *":$PNPM_HOME:"*) ;;
    *) export PATH="$PNPM_HOME:$PATH" ;;
  esac
fi

# user-local binaries
export PATH="$HOME/.local/bin:$PATH"

# fzf
if command -v fzf &> /dev/null; then
  source <(fzf --zsh)
fi

# zoxide (smart cd)
if command -v zoxide &> /dev/null; then
  eval "$(zoxide init zsh --cmd cd)"
fi

# starship prompt
if command -v starship &> /dev/null; then
  eval "$(starship init zsh)"
fi

# ============================================================
# Local overrides — machine-specific, last so they win
# ============================================================
try_source ~/.env
try_source ~/.zshrc.local
